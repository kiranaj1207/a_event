# ==============================================================================
# IMARTICUS DATATHON 2026 - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server configuration
PORT=3000
NODE_ENV=development

# Allowed frontend origin for CORS in production (e.g. https://yourdomain.com)
FRONTEND_ORIGIN=*

# Google Form Submission Endpoint (Must end in /formResponse)
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/1FAIpQLScuXoumlmaV712ZRpSC8tDow-XgNP2dFmgwrnKSe4Umb4Oj2A/formResponse

# ------------------------------------------------------------------------------
# PAGE 1: Team & Leader Details Entry IDs (Derived from FB_PUBLIC_LOAD_DATA_)
# ------------------------------------------------------------------------------
GOOGLE_FORM_TEAM_NAME_ENTRY=entry.532720504
GOOGLE_FORM_COURSE_ENTRY=entry.1505841488
GOOGLE_FORM_YEAR_ENTRY=entry.471912979
GOOGLE_FORM_LEADER_NAME_ENTRY=entry.95054344
GOOGLE_FORM_LEADER_REGNO_ENTRY=entry.1311668077
GOOGLE_FORM_LEADER_EMAIL_ENTRY=entry.1169441784
GOOGLE_FORM_LEADER_PHONE_ENTRY=entry.1786431928
GOOGLE_FORM_TEAM_SIZE_ENTRY=entry.212519596

# ------------------------------------------------------------------------------
# MULTI-PAGE CONDITIONAL BRANCHING ENTRY IDs
# The form uses distinct entry IDs for each team-size section:
# ------------------------------------------------------------------------------
# Team Size = 2 (Section: "Team of 2: Member Details")
GOOGLE_FORM_T2_MEMBER2_NAME_ENTRY=entry.197190944
GOOGLE_FORM_T2_MEMBER2_REGNO_ENTRY=entry.900469978

# Team Size = 3 (Section: "Team of 3: Member Details")
GOOGLE_FORM_T3_MEMBER2_NAME_ENTRY=entry.470766011
GOOGLE_FORM_T3_MEMBER2_REGNO_ENTRY=entry.806985892
GOOGLE_FORM_T3_MEMBER3_NAME_ENTRY=entry.670603800
GOOGLE_FORM_T3_MEMBER3_REGNO_ENTRY=entry.77314024

# Team Size = 4 (Section: "Team of 4: Member Details")
GOOGLE_FORM_T4_MEMBER2_NAME_ENTRY=entry.233709409
GOOGLE_FORM_T4_MEMBER2_REGNO_ENTRY=entry.1511120998
GOOGLE_FORM_T4_MEMBER3_NAME_ENTRY=entry.604928895
GOOGLE_FORM_T4_MEMBER3_REGNO_ENTRY=entry.396290915
GOOGLE_FORM_T4_MEMBER4_NAME_ENTRY=entry.381545999
GOOGLE_FORM_T4_MEMBER4_REGNO_ENTRY=entry.1181572906

# Final Confirmation Page checkbox entry ID
GOOGLE_FORM_CONFIRMATION_ENTRY=entry.2117435691
GOOGLE_FORM_CONFIRMATION_TEXT="I confirm that our team has 2–4 students and the information provided is accurate."
